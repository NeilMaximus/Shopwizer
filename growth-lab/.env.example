# Growth Lab contact form: environment variables for the Vercel project
# (Project, Settings, Environment Variables). Never commit real values.
# All four are required. Without any one of them the form stays switched off and says so.

# Google reCAPTCHA v2, "I'm not a robot" checkbox. Create the keys in the Google reCAPTCHA admin
# console for growthlab.co.za and any preview domain you test on. The site key is public; the
# secret key is not.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend: an API key with sending access, and a sender address on a domain verified in Resend,
# for example: Growth Lab website <website@growthlab.co.za>
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional: comma separated hostnames that reCAPTCHA must report, for example
# growthlab.co.za,www.growthlab.co.za
CONTACT_ALLOWED_HOSTNAMES=
