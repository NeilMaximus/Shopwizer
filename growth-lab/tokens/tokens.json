{
  "$description": "Growth Lab website tokens. Generated from tokens/tokens.css. Rules: DESIGN_SYSTEM.md",
  "colour": {
    "gl-purple": "#7761FF",
    "gl-coral": "#FF4E4E",
    "gl-amber": "#FEBC2E",
    "gl-amber-tint": "#FFF1CC",
    "gl-purple-strong": "#644CF0",
    "gl-purple-soft": "#D9D3FF",
    "gl-white": "#FFFFFF",
    "gl-panel": "#F5F5F5",
    "gl-panel-strong": "#EBEBEB",
    "gl-line": "#E5E5E5",
    "gl-ink": "#111111",
    "gl-ink-2": "#404040",
    "gl-ink-3": "#666666",
    "gl-idle": "#C4C4C4",
    "gl-rune-top": "#F1F1F1",
    "gl-rune-bottom": "#E3E3E3",
    "gl-black": "#111111",
    "gl-on-black": "#D4D4D4",
    "gl-on-black-2": "#A3A3A3",
    "gl-core-top": "#3A3A38",
    "gl-core-left": "#222221",
    "gl-core-right": "#111111"
  },
  "type": {
    "gl-font": "\"Geist\", \"Geist Fallback\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "gl-weight-regular": "400",
    "gl-weight-medium": "500",
    "gl-weight-semibold": "600",
    "gl-text-small": "13px",
    "gl-text-ui": "15px",
    "gl-text-body": "17px",
    "gl-text-lead": "clamp(18px, 1.5vw, 20px)",
    "gl-track-display": "-0.035em",
    "gl-track-heading": "-0.02em",
    "gl-track-ui": "-0.005em"
  },
  "layout": {
    "gl-wrap": "1200px",
    "gl-gutter": "clamp(20px, 4vw, 48px)",
    "gl-section": "clamp(72px, 10vw, 140px)",
    "gl-radius-panel": "28px",
    "gl-radius-node": "14px",
    "gl-radius-image": "10px",
    "gl-radius-pill": "999px"
  },
  "motion": {
    "gl-ease": "cubic-bezier(0.65, 0, 0.35, 1)",
    "gl-rune-cycle": "8s"
  }
}
